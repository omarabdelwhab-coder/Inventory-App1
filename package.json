{
  "name": "inventory-app",
  "version": "1.0.0",
  "description": "Inventory Management Desktop Application",
  "main": "electron/main.js",
  "author": "Omar Abdelwhab",
  "license": "MIT",

  "scripts": {
    "build:client": "cd client && npm run build",
    "start": "electron .",
    "dist": "npm run build:client && electron-builder"
  },

  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.15.3"
  },

  "build": {
  "appId": "com.omar.inventoryapp",
  "productName": "Inventory App",

  "files": [
    "electron/**/*",
    "client/dist/**/*",
    "server/**/*",
    "package.json"
  ],

  "asarUnpack": [
    "server/**"
  ],

  "win": {
    "target": "nsis"
  },

  "nsis": {
    "oneClick": true,
    "perMachine": false
  }
}
}